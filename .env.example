# Copy this file to .env and fill in your own values.
# NOTE: if creating .env by hand in Notepad, use "Save as type: All Files"
# -- otherwise Notepad saves it as ".env.txt" and it will be ignored.

# http or https. Most self-hosted Icecast servers use http; some hosted
# providers are https-only.
ICECAST_SCHEME=http

# Hostname of your Icecast server, e.g. icecast.example.com
ICECAST_HOST=

# Port your Icecast server listens on, e.g. 8000
ICECAST_PORT=8000

# Exact mount point string, INCLUDING the leading slash, e.g. /stream
# Get this from your server's own /admin/publicstats.json, not a dashboard --
# fonts can make l (lowercase L), I (capital i), and i look identical.
ICECAST_MOUNT=

# Username for the /admin/metadata endpoint.
# Vanilla Icecast: usually "admin" or "source".
# Some hosted providers: a username tied to your account.
ICECAST_USERNAME=

# Password or API token for the /admin/metadata endpoint.
# Vanilla Icecast: your admin/source password.
# Some hosted providers: an API token used in place of a password.
ICECAST_TOKEN=

# Path to the local file used to pass now-playing text between
# now_playing.py and nowplaying_poller.py.
NOWPLAYING_FILE=now_playing.txt

# Which Mixxx Aux inputs Spotify / YouTube reach is read live from Windows
# (the Voicemeeter input each app plays into, e.g. picked in EarTrumpet) and
# Voicemeeter (that strip's lit B buttons). A title is only sent while one of
# those Aux inputs is on air (PLAY on, fader up), as reported by the TelosFM
# Bridge Mixxx mapping (see mixxx-bridge/ in the README).
#
# The Mixxx Aux each Voicemeeter B bus feeds, in order B1,B2,B3 (0 = not a
# Mixxx input). Match Mixxx -> Preferences -> Sound Hardware -> Input.
VOICEMEETER_BUS_AUX=1,2,3

# Fallback Aux per source, used only when the live route can't be read.
SPOTIFY_AUX=1
YOUTUBE_AUX=2

# Optional: loopMIDI port name the TelosFM Bridge mapping talks on.
# MIXXX_BRIDGE_MIDI_PORT=TelosFM Bridge

# How often (seconds) each script polls/checks for changes.
POLL_INTERVAL=5

# Dead-air monitor: continuous quiet time before SILENCE is declared.
DEAD_AIR_SECONDS=30

# Audio whose peak stays at or below this level counts as quiet.
SILENCE_THRESHOLD_DBFS=-60

# Dead-air monitor audio source: the Voicemeeter strip Mixxx's Main output
# plays into, 0-based across all strips (hardware first, then virtual). On
# Voicemeeter Potato, 6 = the AUX Input virtual strip.
DEAD_AIR_VOICEMEETER_STRIP=6

# Optional: full path to VoicemeeterRemote64.dll. Found automatically when blank.
VOICEMEETER_DLL=

# Seconds between Caster.fm stats checks for STREAM OFFLINE.
# DEAD_AIR_STREAM_CHECK_SECONDS=5

# Live status dashboard (dashboard.py) -- all optional, shown with their
# defaults. Only change these if the port conflicts with something else or
# you want the status JSON files somewhere other than this folder.
# DASHBOARD_PORT=8766
# DASHBOARD_STALE_SECONDS=15
# NOW_PLAYING_STATUS_FILE=now_playing_status.json
# POLLER_STATUS_FILE=poller_status.json
# DEAD_AIR_STATUS_FILE=dead_air_status.json
# Seconds between Caster.fm listener-stats checks for the Caster.fm card.
# CASTER_STATS_INTERVAL=15
